# jky 适配器环境变量配置
# 复制此文件为 .env 并填入真实值
# 注意：.env 文件不应提交到 Git！

# =============================================================================
# 基础配置
# =============================================================================

# 接口类型 (standard/qimen)
JKY_DEFAULT_INTERFACE=standard

# 环境标识 (production/sandbox/development)
JKY_ENVIRONMENT=sandbox

# =============================================================================
# Standard 接口配置（主接口）
# 文档：https://open.jackyun.com/
# =============================================================================

# API 基础地址
JKY_STANDARD_HOST=https://open.jackyun.com/open/openapi/do

# 认证参数
JKY_APP_KEY=your-app-key
JKY_APP_SECRET=your-app-secret
JKY_TOKEN=your-token
JKY_VERSION=1.0

# =============================================================================
# Qimen 接口配置（奇门网关，备用接口）
# =============================================================================

# API 基础地址
JKY_QIMEN_HOST=https://zci2vl4joy.api.taobao.com/router/qm

# 认证参数
JKY_QIMEN_APP_KEY=your-app-key
JKY_QIMEN_APP_SECRET=your-app-secret
JKY_QIMEN_TARGET_APP_KEY=your-target-app-key
JKY_QIMEN_JKY_APP_KEY=your-jky-app-key
JKY_QIMEN_JKY_APP_SECRET=your-jky-app-secret
JKY_QIMEN_CUSTOMER_ID=your-customer-id
